# Dockerfile.build-old
# Builds gmet-old (v0.10.2) from GitHub master branch.
#
# Problem: master branch is missing governance_abi.go and governance_legacy_abi.go
# Fix: check out those two files from the feature/geth-v1.13.14 branch
# (which defines the same ABI variables that admin.go references)
#
# Usage (run from tests/server36/):
#   docker build -f Dockerfile.build-old -t gmet-old-builder:latest .
#   docker run --rm -v $(pwd):/output gmet-old-builder:latest \
#     cp /build/gmet-old /output/gmet-old-built

FROM golang:1.21-bullseye AS builder

ARG REPO=https://github.com/jsong1230/go-metadium.git
ARG MASTER_BRANCH=master
ARG FEATURE_BRANCH=feature/geth-v1.13.14

WORKDIR /build

# Clone master branch
RUN git clone --depth 50 --branch ${MASTER_BRANCH} ${REPO} .

# Apply fix: check out missing ABI files from feature branch
# These define RegistryAbi, GovAbi, StakingAbi, EnvStorageImpAbi, TRSListAbi
# and their legacy counterparts — referenced by admin.go but absent from master
RUN git fetch --depth 1 origin ${FEATURE_BRANCH} && \
    git checkout FETCH_HEAD -- \
        metadium/governance_abi.go \
        metadium/governance_legacy_abi.go

# Build LevelDB binary (statically linked, no CGO)
RUN CGO_ENABLED=0 go build -o gmet-old ./cmd/geth && \
    ./gmet-old version

FROM scratch
COPY --from=builder /build/gmet-old /gmet-old
